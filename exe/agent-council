#!/usr/bin/env ruby
# frozen_string_literal: true

# agent-council — executable entry point. All code lives in lib/:
#   lib/agent_council.rb                       orchestration (AgentCouncil)
#   lib/agent_council/harnesses/pi_harness.rb  pi-specific behavior (AgentCouncil::Harnesses::PiHarness)
#
# Usage:
#   agent-council [-o OUTPUT_DIR] PROMPT_FILE [CONFIG_FILE]
#   agent-council --consolidate RUN_DIR
#
# AGENT_COUNCIL_OPTS may set default options (currently only --output-dir),
# but not positional args or one-shot switches such as --consolidate, --help
# or --version. An env --output-dir is ignored with --consolidate.
# CONFIG_FILE defaults to ./agent-council.yml in the current directory (no
# upward directory search), else ~/.agent-council.yml, if either exists;
# otherwise it is required.
# Sample configs: examples/configs/ (in the installed gem and the repository).
# Run FROM the repository you want analyzed: the harness analyzes its own cwd.

require_relative '../lib/agent_council'

AgentCouncil.main(ARGV)
