#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../lib/agent_council/pi_models'

help_output = ARGV.delete('-h') || ARGV.delete('--help')
json_output = ARGV.delete('--json') || ARGV.delete('-j')
ids_output = ARGV.delete('--ids') || ARGV.delete('-i')

if help_output
  puts AgentCouncil::PiModels.help_text
  exit
end

models = AgentCouncil::PiModels.fetch_models

if json_output
  puts AgentCouncil::PiModels.format_as_json(models)
elsif ids_output
  puts AgentCouncil::PiModels.format_as_ids(models)
else
  puts AgentCouncil::PiModels.format_as_table(models)
end
