#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../lib/agent_council/platform'

AgentCouncil.abort_if_native_windows('agent-council-ps')

require_relative '../lib/agent_council/ps'

if ARGV.include?('-h') || ARGV.include?('--help')
  puts AgentCouncil::Ps::HELP
  exit
end

begin
  exit AgentCouncil::Ps.run(ARGV)
rescue AgentCouncil::Ps::UsageError => e
  warn "agent-council-ps: #{e.message}"
  warn "Try 'agent-council-ps --help' for usage."
  exit 2
rescue AgentCouncil::Ps::Error => e
  warn "agent-council-ps: #{e.message}"
  exit 1
rescue Interrupt
  exit 0
end
